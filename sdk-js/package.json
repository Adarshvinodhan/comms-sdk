{
  "name": "@comms/sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic client for the comms service: DMs, presence, read receipts and LiveKit-backed calls.",
  "license": "MIT",
  "author": "legpieze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adarshvinodhan/live-kit.git",
    "directory": "packages/sdk-js"
  },
  "homepage": "https://github.com/Adarshvinodhan/live-kit/tree/master/packages/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/Adarshvinodhan/live-kit/issues"
  },
  "keywords": [
    "chat",
    "dm",
    "messaging",
    "presence",
    "livekit",
    "calls",
    "socket.io"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
