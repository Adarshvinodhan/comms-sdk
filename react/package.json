{
  "name": "@sminfotech/comms-react",
  "version": "0.1.0",
  "description": "React provider, hooks and components for the comms service: DM inbox and threads, ringing, and LiveKit audio/video calls.",
  "license": "MIT",
  "author": "legpieze",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adarshvinodhan/comms-sdk.git",
    "directory": "react"
  },
  "homepage": "https://github.com/Adarshvinodhan/comms-sdk/tree/main/react#readme",
  "bugs": {
    "url": "https://github.com/Adarshvinodhan/comms-sdk/issues"
  },
  "keywords": [
    "react",
    "chat",
    "dm",
    "messaging",
    "livekit",
    "video-call",
    "audio-call"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@sminfotech/comms-sdk": "^0.1.0"
  },
  "peerDependencies": {
    "@livekit/components-react": "^2.9.0",
    "@livekit/components-styles": "^1.2.0",
    "livekit-client": "^2.15.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/components-styles": "^1.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
