{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "paths": {
      "@sminfotech/comms-sdk": ["../sdk-js/src/index.ts"]
    }
  },
  "include": ["src"]
}
